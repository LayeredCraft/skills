{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "CLAUDE.local.md"
  ],
  "formatter": {
    "mdformat": {
      "command": [
        "uvx",
        "--with",
        "mdformat-frontmatter",
        "mdformat",
        "$FILE",
        "--exclude",
        ".opencode/**",
        "--exclude",
        ".calude/**"
      ],
      "extensions": [
        ".md"
      ]
    }
  }
}